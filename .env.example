APP_ENV=local
SESSION_COOKIE_SECURE=0

# Application database connection.
# The current backend uses PostgreSQL/PDO by default.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=postgres

# Code teachers enter to self-register as a teacher. Empty disables teacher sign-up.
TEACHER_REGISTER_CODE=

# Supabase Storage for uploaded images (bucket: kidlearn-images).
# Use the service_role / secret key from Project Settings > API. Server-side only, never expose it to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# SMTP for OTP emails (change password and forgot password). Port 465 = TLS, 587 = STARTTLS.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=your Gmail address, SMTP_PASS=an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=KidLearn
