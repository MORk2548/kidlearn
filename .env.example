APP_ENV=local
SESSION_COOKIE_SECURE=0

# Application database connection.
# The current backend uses PostgreSQL/PDO by default.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=postgres

# Supabase Storage for uploaded images (bucket: kidlearn-images).
# Use the service_role / secret key from Project Settings > API. Server-side only, never expose it to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
