# KidLearn .htaccess
Options -Indexes
RewriteEngine On

# ให้ PHP จัดการทุก request ไปที่ api/
<FilesMatch "\.php$">
    SetHandler application/x-httpd-php
</FilesMatch>

# JS/CSS URLs include a version query string; bump it when asset contents change.
<FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
