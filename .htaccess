# KidLearn .htaccess
Options -Indexes
RewriteEngine On

# Docker serves the whole repo; only the pages, js/, images/, files/ and api/backend.php are meant to be public.
RewriteRule (^|/)\. - [F]
RewriteRule ^(scripts|backups|docker|content)(/|$) - [F]
<FilesMatch "\.(sql|md|py|ps1|bat|sh|ya?ml|log)$">
    Require all denied
</FilesMatch>

# ให้ PHP จัดการทุก request ไปที่ api/
<FilesMatch "\.php$">
    SetHandler application/x-httpd-php
</FilesMatch>

# JS/CSS URLs include a version query string; bump it when asset contents change.
<FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# หน้า HTML ต้องถามเซิร์ฟเวอร์ทุกครั้ง ไม่อย่างนั้นเบราว์เซอร์ใช้หน้าเก่าที่ยังชี้ไป JS/CSS เวอร์ชันเก่าหลัง deploy
<FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
</FilesMatch>
